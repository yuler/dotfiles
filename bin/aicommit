#!/usr/bin/env bash

# AI-assisted git commit.
#
# Try agents in order: opencode → cursor-agent → pi. Stop on first success;
# if all fail, exit with error. Note: this is an executable script (not a
# sourced shell function), so we cannot rely on shell aliases like `gaa`/`gpo`.

OPENCODE_MODEL="${AICOMMIT_MODEL:-}"
AICOMMIT_AGENT_TIMEOUT="${AICOMMIT_AGENT_TIMEOUT:-180}"
LOCK_FILE="${AICOMMIT_LOCK_FILE:-${XDG_RUNTIME_DIR:-/tmp}/aicommit.lock}"
AICOMMIT_TOTAL_INPUT=0
AICOMMIT_TOTAL_OUTPUT=0
INTERRUPTED=0

usage() {
  echo "Usage: aicommit [-p|--push]"
  echo "  -p, --push   Push current branch after commit"
  echo ""
  echo "Environment:"
  echo "  AICOMMIT_MODEL           opencode model override (default: unset → opencode's default model)"
  echo "  AICOMMIT_AGENT_TIMEOUT   agent timeout in seconds (default: 180)"
}

parse_args() {
  SHOULD_PUSH=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -p|--push)
        SHOULD_PUSH=true
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        echo "Unknown option: $1"
        usage
        exit 1
        ;;
    esac
    shift
  done
}

require_git_repo() {
  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "Not inside a git repository. Run aicommit from a project directory."
    exit 1
  fi
}

has_staged_changes() {
  ! git diff --cached --quiet
}

now_ms() {
  local v
  v="$(date +%s%N 2>/dev/null)"
  if [[ "$v" =~ ^[0-9]+$ ]]; then
    printf '%s\n' "${v:0:13}"
  else
    printf '%s000\n' "$(date +%s)"
  fi
}

fmt_duration() {
  local ms="$1"
  if (( ms >= 60000 )); then
    printf '%dm %ds\n' $((ms / 60000)) $(((ms % 60000) / 1000))
  elif (( ms >= 1000 )); then
    printf '%.1fs\n' "$(awk "BEGIN{printf \"%.1f\", $ms/1000}")"
  else
    printf '%dms\n' "$ms"
  fi
}

# 1000 → 1K, 1_000_000 → 1M; strip trailing .0
fmt_tokens() {
  local n="$1" scaled unit
  if (( n >= 1000000 )); then
    scaled="$(awk "BEGIN{printf \"%.1f\", $n/1000000}")"
    unit=M
  elif (( n >= 1000 )); then
    scaled="$(awk "BEGIN{printf \"%.1f\", $n/1000}")"
    unit=K
  else
    printf '%s\n' "$n"
    return
  fi
  scaled="${scaled%.0}"
  printf '%s%s\n' "$scaled" "$unit"
}

gum_out() {
  local color="$1" text="$2"
  if command -v gum >/dev/null 2>&1; then
    gum style --foreground "$color" --bold "$text"
  else
    echo "$text"
  fi
}

json_usage_sum() {
  local file="$1" filter="$2" sum
  command -v jq >/dev/null 2>&1 || return 1
  sum="$(jq -s "$filter" "$file" 2>/dev/null)" || return 1
  [[ "$sum" =~ ^[0-9]+$ && "$sum" != "0" ]] || return 1
  printf '%s\n' "$sum"
}

add_usage() {
  local in="$1" out="$2"
  AICOMMIT_TOTAL_INPUT=$((AICOMMIT_TOTAL_INPUT + in))
  AICOMMIT_TOTAL_OUTPUT=$((AICOMMIT_TOTAL_OUTPUT + out))
}

add_opencode_usage() {
  local file="$1" tin tout
  tin="$(json_usage_sum "$file" '[.[] | select(.type == "step_finish" and .part.tokens) | .part.tokens.input] | add // 0')" || tin=0
  tout="$(json_usage_sum "$file" '[.[] | select(.type == "step_finish" and .part.tokens) | .part.tokens.output] | add // 0')" || tout=0
  add_usage "$tin" "$tout"
}

add_cursor_usage() {
  local file="$1" tin tout
  tin="$(json_usage_sum "$file" '[.[] | select(.type == "result") | .usage.inputTokens] | add // 0')" || tin=0
  tout="$(json_usage_sum "$file" '[.[] | select(.type == "result") | .usage.outputTokens] | add // 0')" || tout=0
  add_usage "$tin" "$tout"
}

add_pi_usage() {
  local file="$1" tin tout
  tin="$(json_usage_sum "$file" '[.[] | select(.type == "message_end") | .message.usage.input] | add // 0')" || tin=0
  tout="$(json_usage_sum "$file" '[.[] | select(.type == "message_end") | .message.usage.output] | add // 0')" || tout=0
  add_usage "$tin" "$tout"
}

# Print summary once at exit (tokens + duration).
print_summary() {
  local now diff total
  now="$(now_ms)"
  diff=$((now - START_TIME))

  if (( AICOMMIT_TOTAL_INPUT > 0 || AICOMMIT_TOTAL_OUTPUT > 0 )); then
    total=$((AICOMMIT_TOTAL_INPUT + AICOMMIT_TOTAL_OUTPUT))
    gum_out 39 "Tokens: $(fmt_tokens "$total") total ($(fmt_tokens "$AICOMMIT_TOTAL_INPUT") in / $(fmt_tokens "$AICOMMIT_TOTAL_OUTPUT") out)"
  fi
  gum_out 212 "Total time: $(fmt_duration "$diff")"
}

on_exit() {
  print_summary
}

# Recurse by parent pid so children GNU timeout moved into another
# process group are still found.
list_descendants() {
  local parent="$1" child
  while read -r child; do
    [[ -z "$child" ]] && continue
    list_descendants "$child"
    printf '%s\n' "$child"
  done < <(pgrep -P "$parent" 2>/dev/null || true)
}

stop_children() {
  local -a pids=()
  local pid
  while read -r pid; do
    [[ -z "$pid" ]] && continue
    pids+=("$pid")
  done < <(list_descendants $$)

  if ((${#pids[@]} > 0)); then
    kill -TERM "${pids[@]}" 2>/dev/null || true
    sleep 0.05
    kill -KILL "${pids[@]}" 2>/dev/null || true
  fi
  cleanup_stale_opencode
}

on_interrupt() {
  INTERRUPTED=1
  trap '' INT TERM
  echo "Interrupted, stopping..." >&2
  stop_children
  exit 130
}

was_interrupted() {
  local status="${1:-0}"
  (( INTERRUPTED == 1 || status == 130 || status == 143 ))
}

find_git_commit_skill_dir() {
  local candidate
  for candidate in \
    ".agents/skills/git-commit" \
    "$HOME/.agents/skills/git-commit" \
    "$HOME/.claude/skills/git-commit" \
    "$HOME/.config/opencode/skills/git-commit"; do
    if [[ -f "$candidate/SKILL.md" && -f "$candidate/scripts/git-diff.sh" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

cleanup_stale_opencode() {
  local pid
  while read -r pid; do
    [[ -z "$pid" ]] && continue
    kill -9 "$pid" 2>/dev/null || true
  done < <(pgrep -f 'opencode.*run' 2>/dev/null || true)
}

# GNU timeout / gtimeout when present; otherwise a compact bash fallback
# that maps SIGTERM/SIGKILL to GNU timeout's exit 124.
#
# Always run in the background and wait(1) so a SIGINT trap can fire
# immediately. A foreground timeout defers the trap until the agent exits,
# which is why Ctrl+C could not stop aicommit.
run_with_timeout() {
  local secs="$1" pid watcher status
  shift

  # Close lock fd 9 so children cannot hold the flock after we exit.
  if command -v timeout >/dev/null 2>&1; then
    timeout --kill-after=2 "$secs" "$@" 9>&- &
    pid=$!
    wait "$pid"
    status=$?
    was_interrupted "$status" && return 130
    return "$status"
  fi
  if command -v gtimeout >/dev/null 2>&1; then
    gtimeout --kill-after=2 "$secs" "$@" 9>&- &
    pid=$!
    wait "$pid"
    status=$?
    was_interrupted "$status" && return 130
    return "$status"
  fi

  "$@" 9>&- &
  pid=$!
  (sleep "$secs" && kill -TERM "$pid" 2>/dev/null) 9>&- &
  watcher=$!
  wait "$pid"
  status=$?
  pkill -P "$watcher" 2>/dev/null || true
  kill "$watcher" 2>/dev/null || true
  wait "$watcher" 2>/dev/null || true
  was_interrupted "$status" && return 130
  if [[ $status -eq 143 || $status -eq 137 ]]; then
    return 124
  fi
  return "$status"
}

commit_prompt() {
  local skill_dir="$1"
  printf '%s\n' "Follow ${skill_dir}/SKILL.md. Run bash ${skill_dir}/scripts/git-diff.sh, then commit staged changes with an emoji message per the skill. Do not push."
}

agent_opencode() {
  if ! command -v opencode >/dev/null 2>&1; then
    echo "opencode not found in PATH"
    return 127
  fi

  cleanup_stale_opencode

  local -a cmd=(opencode --pure --agent build --format json)
  if [[ -n "$OPENCODE_MODEL" ]]; then
    cmd=(opencode --pure --model "$OPENCODE_MODEL" --agent build --format json)
  fi
  cmd+=(run /git-commit)

  local tmp status quoted
  tmp="$(mktemp "${TMPDIR:-/tmp}/aicommit-opencode.XXXXXX")" || return 1
  quoted="$(printf '%q ' "${cmd[@]}")"

  if ! run_with_timeout "$AICOMMIT_AGENT_TIMEOUT" bash -c "set -o pipefail; $quoted | tee '$tmp' | jq -j 'select(.type == \"text\" or (.type == \"tool_use\" and .part.tool == \"bash\")) | if .type == \"text\" then .part.text + \"\\n\" else \"\$ \" + .part.state.input.command + \"\\n\" end' 2>/dev/null; s=\$?; printf '\\n'; exit \"\$s\""; then
    status=$?
    rm -f "$tmp"
    if [[ $status -eq 124 ]]; then
      echo "opencode timed out after ${AICOMMIT_AGENT_TIMEOUT}s"
    else
      echo "opencode failed (exit $status)"
    fi
    cleanup_stale_opencode
    return "$status"
  fi

  add_opencode_usage "$tmp"
  rm -f "$tmp"
  return 0
}

agent_cursor() {
  local skill_dir
  if ! skill_dir="$(find_git_commit_skill_dir)"; then
    echo "git-commit skill not found (checked .agents, ~/.agents, ~/.claude, ~/.config/opencode)"
    return 1
  fi

  if ! command -v cursor-agent >/dev/null 2>&1; then
    echo "cursor-agent not found in PATH"
    return 127
  fi

  local prompt tmp status
  prompt="$(commit_prompt "$skill_dir")"
  tmp="$(mktemp "${TMPDIR:-/tmp}/aicommit-cursor.XXXXXX")" || return 1

  if command -v jq >/dev/null 2>&1; then
    if ! run_with_timeout "$AICOMMIT_AGENT_TIMEOUT" bash -c "set -o pipefail; cursor-agent -p --force --output-format json '$prompt' | tee '$tmp' | jq -j 'select(.type == \"assistant\" or .type == \"result\") | if .type == \"assistant\" then (.message.content | map(.text // empty) | join(\"\")) else .result end, \"\\n\"' 2>/dev/null; s=\$?; printf '\\n'; exit \"\$s\""; then
      status=$?
      rm -f "$tmp"
      if [[ $status -eq 124 ]]; then
        echo "cursor-agent timed out after ${AICOMMIT_AGENT_TIMEOUT}s"
      else
        echo "cursor-agent failed (exit $status)"
      fi
      return "$status"
    fi
  else
    if ! run_with_timeout "$AICOMMIT_AGENT_TIMEOUT" cursor-agent -p --force "$prompt"; then
      status=$?
      rm -f "$tmp"
      if [[ $status -eq 124 ]]; then
        echo "cursor-agent timed out after ${AICOMMIT_AGENT_TIMEOUT}s"
      else
        echo "cursor-agent failed (exit $status)"
      fi
      return "$status"
    fi
    rm -f "$tmp"
    return 0
  fi

  add_cursor_usage "$tmp"
  rm -f "$tmp"
  return 0
}

agent_pi() {
  local skill_dir
  if ! skill_dir="$(find_git_commit_skill_dir)"; then
    echo "git-commit skill not found (checked .agents, ~/.agents, ~/.claude, ~/.config/opencode)"
    return 1
  fi

  if ! command -v pi >/dev/null 2>&1; then
    echo "pi not found in PATH"
    return 127
  fi

  local prompt status=0 tmp
  prompt="$(commit_prompt "$skill_dir")"

  if command -v jq >/dev/null 2>&1; then
    tmp="$(mktemp "${TMPDIR:-/tmp}/aicommit-pi.XXXXXX")" || return 1
    if ! run_with_timeout "$AICOMMIT_AGENT_TIMEOUT" bash -c "set -o pipefail; pi -p --no-session --mode json '$prompt' | tee '$tmp' | jq -j 'select(.type == \"message_update\" and .assistantMessageEvent.type == \"text_delta\") | .assistantMessageEvent.delta' 2>/dev/null; s=\$?; printf '\\n'; exit \"\$s\""; then
      status=$?
      rm -f "$tmp"
      if [[ $status -eq 124 ]]; then
        echo "pi timed out after ${AICOMMIT_AGENT_TIMEOUT}s"
      else
        echo "pi failed (exit $status)"
      fi
      return "$status"
    fi
    add_pi_usage "$tmp"
    rm -f "$tmp"
  else
    if ! run_with_timeout "$AICOMMIT_AGENT_TIMEOUT" pi -p --no-session "$prompt"; then
      status=$?
      if [[ $status -eq 124 ]]; then
        echo "pi timed out after ${AICOMMIT_AGENT_TIMEOUT}s"
      else
        echo "pi failed (exit $status)"
      fi
      return "$status"
    fi
  fi

  return 0
}

commit_succeeded() {
  ! has_staged_changes
}

try_agent() {
  local name="$1"
  local fn="$2"
  local status

  echo "Trying ${name}..."
  "$fn"
  status=$?
  if was_interrupted "$status"; then
    return 130
  fi
  if commit_succeeded; then
    return 0
  fi
  echo "${name} finished but staged changes remain"
  return 1
}

run_commit_agents() {
  local status

  try_agent "opencode" agent_opencode && return 0
  status=$?
  was_interrupted "$status" && return 130
  echo "Falling back to cursor-agent..."
  try_agent "cursor-agent" agent_cursor && return 0
  status=$?
  was_interrupted "$status" && return 130
  echo "Falling back to pi..."
  try_agent "pi" agent_pi && return 0
  status=$?
  was_interrupted "$status" && return 130

  echo "All agents failed (opencode, cursor-agent, pi)"
  return 1
}

acquire_lock() {
  exec 9>"$LOCK_FILE"
  if ! flock -n 9; then
    echo "Another aicommit is already running"
    exit 1
  fi
}

parse_args "$@"
START_TIME="$(now_ms)"
trap on_exit EXIT
trap on_interrupt INT TERM
require_git_repo
acquire_lock

if ! has_staged_changes; then
  git add --all
fi

if ! has_staged_changes; then
  echo "No changes to commit"
  exit 0
fi

if ! run_commit_agents; then
  exit 1
fi

if [[ "$SHOULD_PUSH" != true ]]; then
  exit 0
fi

branch="$(git branch --show-current 2>/dev/null || true)"
if [[ -z "$branch" ]]; then
  echo "No current branch found; skipping push"
  exit 0
fi

git push origin "$branch"
