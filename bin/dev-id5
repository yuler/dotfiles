#!/usr/bin/env bash

session_name="id5"
company_dir="$HOME/Company"
folders=(mall zhsq timeway)

if ! tmux has-session -t "$session_name" 2>/dev/null; then
  # Window 1: ~/Company with split panes
  tmux new-session -d -s "$session_name" -n 'company' -c "$company_dir"
  tmux split-window -h -t "$session_name:company" -c "$company_dir"
  tmux split-window -v -t "$session_name:company" -c "$company_dir"
  tmux select-pane -t "$session_name:company.0"

  # Remaining windows: one tab per folder, tdl with mimo + agent
  for folder in "${folders[@]}"; do
    win_id=$(tmux new-window -t "$session_name" -n "$folder" -c "$company_dir/$folder" -P -F '#{window_id}')
    tmux send-keys -t "$win_id" 'tdl mimo agent' C-m
  done

  tmux select-window -t "$session_name:company"
fi

tmux attach-session -t "$session_name"
