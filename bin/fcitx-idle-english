#!/usr/bin/env bash
# fcitx-idle-english — auto-switch Rime Chinese → English after keyboard idle.
#
# Generated with AI assistance; tested on Omarchy (Hyprland) with fcitx5 + Rime
# Chinese input (Shift toggles Rime ascii_mode 中/英, not fcitx activate/
# deactivate).
#
# How it works
# ------------
# 1. Poll Rime over D-Bus (`IsAsciiMode`). When Chinese (ascii=false), arm an
#    idle timer from a stamp file under $XDG_RUNTIME_DIR.
# 2. Keep the stamp fresh on real activity:
#      • Primary on Omarchy: /dev/input EV_KEY (most apps use wayland_v2, so
#        fcitx InputContext D-Bus signals are not eavesdroppable).
#      • Best-effort: gdbus monitor for UpdateFormattedPreedit / CommitString /
#        ForwardKey / UpdateClientSideUI (only dbus-frontend clients emit these).
# 3. Each poll: if still Chinese and idle >= IDLE_SEC, call SetAsciiMode(true)
#    and optionally notify-send.
# 4. Singleton via flock; keyboard devices are rescanned periodically.
#
# Composition caveat
# ------------------
# Rime D-Bus has no IsComposing. The composing-file deferral only works when
# UpdateFormattedPreedit is visible (dbus frontend). Under wayland_v2 +
# classicui (typical Omarchy apps: terminal, browser, Cursor, WeChat), pausing
# mid-preedit/candidate with no key events still ages the idle timer and may
# switch English and clear composition.
#
# Env:
#   FCITX_IDLE_ENGLISH_SEC     idle seconds (default: 60)
#   FCITX_IDLE_ENGLISH_POLL    poll seconds (default: 1)
#   FCITX_IDLE_ENGLISH_NOTIFY  notify-send on switch (default: 1)
#   FCITX_IDLE_ENGLISH_DEBUG   verbose logs (default: 0)
#
# Omarchy: exec-once from ~/.config/hypr/autostart.conf

set -euo pipefail

# ---------------------------------------------------------------------------
# Config
# ---------------------------------------------------------------------------

IDLE_SEC="${FCITX_IDLE_ENGLISH_SEC:-60}"
POLL_SEC="${FCITX_IDLE_ENGLISH_POLL:-1}"
NOTIFY="${FCITX_IDLE_ENGLISH_NOTIFY:-1}"
DEBUG="${FCITX_IDLE_ENGLISH_DEBUG:-0}"

case "${DEBUG,,}" in 1 | true | yes | on) DEBUG=1 ;; *) DEBUG=0 ;; esac
case "${NOTIFY,,}" in 1 | true | yes | on) NOTIFY=1 ;; *) NOTIFY=0 ;; esac
((IDLE_SEC < 3)) && IDLE_SEC=3

RUNTIME="${XDG_RUNTIME_DIR:-/tmp}"
LOCK_FILE="$RUNTIME/fcitx-idle-english.lock"
STAMP_FILE="$RUNTIME/fcitx-idle-english.stamp"
COMPOSING_FILE="$RUNTIME/fcitx-idle-english.composing"
WATCH_DIR=""
LOG_TAG="fcitx-idle-english"

# Linux input.h
EV_KEY=1
KEY_UNKNOWN=240

FCITX_DEST=org.fcitx.Fcitx5
RIME_PATH=/rime
RIME_IFACE=org.fcitx.Fcitx.Rime1

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

log() {
  printf '[%s] %s\n' "$LOG_TAG" "$*" >&2
}

debug() {
  ((DEBUG)) || return 0
  printf '[%s][debug] %s %s\n' "$LOG_TAG" "$(date '+%H:%M:%S')" "$*" >&2
}

notify_user() {
  ((NOTIFY)) || return 0
  notify-send -u low -a Fcitx "输入法" "$1" 2>/dev/null || true
}

# ---------------------------------------------------------------------------
# Singleton + lifecycle
# ---------------------------------------------------------------------------

acquire_lock() {
  exec 9>"$LOCK_FILE"
  if ! flock -n 9; then
    log "another instance is already running; exiting"
    exit 0
  fi
  printf '%s\n' $$ >&9
}

kill_watchers() {
  local pidfile pid
  [[ -n $WATCH_DIR && -d $WATCH_DIR ]] || return 0
  for pidfile in "$WATCH_DIR"/*.pid; do
    [[ -f $pidfile ]] || continue
    pid=$(<"$pidfile")
    # Kill process group so pipeline children die with the watcher.
    kill -- "-$pid" 2>/dev/null || kill "$pid" 2>/dev/null || true
    pkill -P "$pid" 2>/dev/null || true
    rm -f "$pidfile"
  done
}

cleanup() {
  debug "shutdown"
  kill_watchers
  [[ -n $WATCH_DIR && -d $WATCH_DIR ]] && rm -rf "$WATCH_DIR"
  rm -f "$COMPOSING_FILE"
}

# ---------------------------------------------------------------------------
# Idle stamp
# ---------------------------------------------------------------------------

touch_stamp() {
  date +%s >"$STAMP_FILE"
  [[ -n ${1:-} ]] && debug "stamp ← $1"
}

idle_seconds() {
  local now last
  now=$(date +%s)
  last=$(cat "$STAMP_FILE" 2>/dev/null || echo "$now")
  echo $((now - last))
}

set_composing() {
  if [[ $1 == 1 ]]; then
    echo 1 >"$COMPOSING_FILE"
  else
    rm -f "$COMPOSING_FILE"
  fi
}

is_composing() {
  [[ -f $COMPOSING_FILE ]]
}

# ---------------------------------------------------------------------------
# Keyboard discovery
# ---------------------------------------------------------------------------

# Emit readable /dev/input/event* for real keyboards.
# Skips virtual devices and consumer-control interfaces (REL/ABS spam).
list_keyboards() {
  local name="" handlers="" rel="" abs="" event dev lowered

  flush() {
    [[ -n $handlers ]] || return 0

    event=""
    for event in $handlers; do
      [[ $event == event* ]] && break
      event=""
    done
    [[ -n $event ]] || return 0

    dev="/dev/input/$event"
    [[ -e $dev && -r $dev ]] || return 0

    lowered=$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]')

    case "$lowered" in
      *ydotool* | *virtual* | *speaker* | *"video bus"* | *"power button"* | \
      *"sleep button"* | *"lid switch"* | *hdmi* | *headphone* | *mic* | \
      *"line out"* | *"line in"* | *"pc speaker"* | *touchpad* | *trackpoint*)
        debug "skip $dev ($name) noise"
        return 0
        ;;
    esac

    if [[ $lowered == *mouse* && $lowered != *keyboard* ]]; then
      debug "skip $dev ($name) mouse"
      return 0
    fi

    if [[ " $handlers " != *" kbd "* && $lowered != *keyboard* ]]; then
      debug "skip $dev ($name) not-kbd"
      return 0
    fi

    # Consumer-control / mouse-keys interfaces (e.g. event4 KEY_UNKNOWN flood)
    if [[ -n $rel && $rel != 0 ]] || [[ -n $abs && $abs != 0 ]]; then
      debug "skip $dev ($name) has REL/ABS (consumer iface)"
      return 0
    fi

    debug "accept $dev ($name)"
    printf '%s\n' "$dev"
  }

  while IFS= read -r line || [[ -n $line ]]; do
    if [[ -z $line ]]; then
      flush
      name="" handlers="" rel="" abs=""
      continue
    fi
    case "$line" in
      "N: Name="*) name="${line#N: Name=}" ;;
      "H: Handlers="*) handlers="${line#H: Handlers=}" ;;
      "B: REL="*) rel="${line#B: REL=}" ;;
      "B: ABS="*) abs="${line#B: ABS=}" ;;
    esac
  done < /proc/bus/input/devices
  flush
}

# ---------------------------------------------------------------------------
# Activity watchers
#
# Most apps on this machine use fcitx wayland_v2, NOT the D-Bus InputContext
# frontend — so UpdateFormattedPreedit is not eavesdroppable. Resetting idle
# on real EV_KEY (including Rime composing keys) is the reliable path.
# D-Bus monitor is best-effort for the few dbus-frontend clients.
# ---------------------------------------------------------------------------

watch_fcitx_activity() {
  while true; do
    debug "fcitx dbus monitor start"
    gdbus monitor --session --dest "$FCITX_DEST" 2>/dev/null | while IFS= read -r line; do
      case "$line" in
        *UpdateFormattedPreedit*)
          if [[ $line == *"UpdateFormattedPreedit([],"* ]] ||
            [[ $line == *"UpdateFormattedPreedit([ ],"* ]]; then
            set_composing 0
            touch_stamp "fcitx preedit clear"
          else
            set_composing 1
            touch_stamp "fcitx preedit/composing"
          fi
          ;;
        *CommitString*)
          set_composing 0
          touch_stamp "fcitx commit"
          ;;
        *UpdateClientSideUI*)
          touch_stamp "fcitx client-ui"
          ;;
        *ForwardKey*)
          touch_stamp "fcitx forward-key"
          ;;
      esac
    done
    debug "fcitx dbus monitor exited; retry in 1s"
    sleep 1
  done
}

# Keep the device fd open and read one input_event at a time.
# bash `read -N` → EINVAL on evdev; binary also cannot live in $(...).
# Write one event to a small file, then parse with od.
watch_device() {
  local dev="$1"
  local evbin="$WATCH_DIR/ev.$(basename "$dev").bin"
  local -a bytes
  local typ code val

  exec 3<"$dev" || {
    debug "cannot open $dev"
    return 0
  }
  debug "evdev fd open: $dev"

  while true; do
    if ! dd bs=24 count=1 iflag=fullblock status=none <&3 of="$evbin" 2>/dev/null; then
      debug "evdev dd failed on $dev; reopen in 1s"
      sleep 1
      exec 3<&-
      exec 3<"$dev" || break
      continue
    fi
    if [[ ! -s $evbin ]] || (($(wc -c <"$evbin") != 24)); then
      debug "evdev short read on $dev; reopen in 1s"
      sleep 1
      exec 3<&-
      exec 3<"$dev" || break
      continue
    fi

    mapfile -t bytes < <(od -An -v -t u1 "$evbin" | tr -s '[:space:]' '\n' | grep -E '^[0-9]+$' || true)
    ((${#bytes[@]} == 24)) || continue

    typ=$((bytes[16] | (bytes[17] << 8)))
    code=$((bytes[18] | (bytes[19] << 8)))
    val=$((bytes[20] | (bytes[21] << 8) | (bytes[22] << 16) | (bytes[23] << 24)))

    # Press/release only — ignore KEY_UNKNOWN spam and autorepeat (value=2).
    ((typ == EV_KEY)) || continue
    ((code != KEY_UNKNOWN)) || continue
    ((val == 0 || val == 1)) || continue

    touch_stamp "key $dev code=$code $([ "$val" -eq 1 ] && echo down || echo up)"
  done

  exec 3<&-
  rm -f "$evbin"
  debug "watcher stopped: $dev"
}

start_watchers() {
  local dev i=0 pid

  kill_watchers
  debug "scan keyboards + fcitx dbus"

  watch_fcitx_activity &
  pid=$!
  echo "$pid" >"$WATCH_DIR/fcitx.pid"
  log "watching fcitx dbus (pid $pid)"

  while IFS= read -r dev; do
    [[ -n $dev ]] || continue
    watch_device "$dev" &
    pid=$!
    echo "$pid" >"$WATCH_DIR/$i.pid"
    log "watching $dev (pid $pid)"
    i=$((i + 1))
  done < <(list_keyboards)

  if ((i == 0)); then
    log "no readable keyboards (need group 'input'?)"
  else
    debug "watching $i keyboard device(s) + fcitx dbus"
  fi
}

# ---------------------------------------------------------------------------
# Rime / fcitx status
# ---------------------------------------------------------------------------

# Returns 0 if Rime is in Chinese (ascii_mode=false).
rime_is_chinese() {
  local out
  out=$(gdbus call --session \
    --dest "$FCITX_DEST" \
    --object-path "$RIME_PATH" \
    --method "$RIME_IFACE.IsAsciiMode" 2>/dev/null) || return 1
  # gdbus prints "(false,)" or "(true,)"
  [[ $out == *false* ]]
}

rime_switch_english() {
  gdbus call --session \
    --dest "$FCITX_DEST" \
    --object-path "$RIME_PATH" \
    --method "$RIME_IFACE.SetAsciiMode" true >/dev/null 2>&1
}

rime_schema() {
  gdbus call --session \
    --dest "$FCITX_DEST" \
    --object-path "$RIME_PATH" \
    --method "$RIME_IFACE.GetCurrentSchema" 2>/dev/null |
    tr -d "()', " || true
}

wait_for_rime() {
  local i
  for i in $(seq 1 60); do
    if gdbus call --session \
      --dest "$FCITX_DEST" \
      --object-path "$RIME_PATH" \
      --method "$RIME_IFACE.IsAsciiMode" >/dev/null 2>&1; then
      debug "rime ready schema=$(rime_schema) chinese=$(rime_is_chinese && echo yes || echo no)"
      return 0
    fi
    debug "waiting for rime dbus..."
    sleep 1
  done
  log "rime dbus not available; will keep retrying"
}

# ---------------------------------------------------------------------------
# Main loop
# ---------------------------------------------------------------------------

main_loop() {
  local was_chinese=0 idle_for remain
  local rescan_every=120 loops=0

  while true; do
    loops=$((loops + 1))
    if ((loops >= rescan_every)); then
      start_watchers
      loops=0
    fi

    if rime_is_chinese; then
      if ((was_chinese == 0)); then
        touch_stamp "entered Chinese"
        log "Chinese (Rime ascii=false); idle timer armed"
        was_chinese=1
      fi

      idle_for=$(idle_seconds)
      remain=$((IDLE_SEC - idle_for))
      ((remain < 0)) && remain=0

      if is_composing; then
        # Preedit active → do not switch (stamp already refreshed by dbus).
        debug "zh composing; switch deferred schema=$(rime_schema)"
      else
        debug "zh idle=${idle_for}s remain=${remain}s schema=$(rime_schema)"

        if ((idle_for >= IDLE_SEC)); then
          debug "threshold hit → SetAsciiMode(true)"
          if rime_switch_english; then
            log "auto-switched to English after ${idle_for}s idle"
            notify_user "已自动切换到英文输入"
            was_chinese=0
            touch_stamp "after switch"
          else
            log "SetAsciiMode failed; will retry"
          fi
        fi
      fi
    else
      if ((was_chinese == 1)); then
        debug "left Chinese (manual Shift or external)"
      fi
      was_chinese=0
      set_composing 0
    fi

    sleep "$POLL_SEC"
  done
}

# ---------------------------------------------------------------------------
# Entry
# ---------------------------------------------------------------------------

acquire_lock
WATCH_DIR="$(mktemp -d "$RUNTIME/fcitx-idle-english.XXXXXX")"
trap cleanup EXIT INT TERM

log "started (idle=${IDLE_SEC}s poll=${POLL_SEC}s notify=${NOTIFY} debug=${DEBUG})"
debug "pid=$$ stamp=$STAMP_FILE"

wait_for_rime
touch_stamp "startup"
set_composing 0
start_watchers
main_loop
