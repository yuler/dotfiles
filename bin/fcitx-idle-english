#!/usr/bin/env bash
# fcitx-idle-english — auto-switch Rime Chinese → English after keyboard idle.
#
# Omarchy (Hyprland) + fcitx5 + Rime: Shift toggles Rime ascii_mode 中/英,
# not fcitx activate/deactivate.
#
# 1. Poll Rime `IsAsciiMode`. When Chinese (ascii=false), arm an idle timer
#    from a stamp file under $XDG_RUNTIME_DIR.
# 2. Refresh the stamp on real EV_KEY (press / release / autorepeat).
#    Most apps use wayland_v2, so fcitx InputContext D-Bus is not used.
# 3. If still Chinese (Rime current, ascii=false) and idle >= IDLE_SEC
#    → SetAsciiMode(true). Skip if already English (keyboard-us or Rime ascii).
# 4. Singleton via flock; keyboard devices are rescanned periodically.
#
# Pausing mid-preedit with no key events still ages the timer and may switch
# English (Rime has no IsComposing on D-Bus).
#
# Env:
#   FCITX_IDLE_ENGLISH_SEC     idle seconds (default: 30)
#   FCITX_IDLE_ENGLISH_POLL    poll seconds (default: 1)
#   FCITX_IDLE_ENGLISH_NOTIFY  notify-send on switch (default: 1)
#   FCITX_IDLE_ENGLISH_DEBUG   verbose logs (default: 1)
#
# Omarchy: exec-once from ~/.config/hypr/autostart.conf

set -euo pipefail

# ---------------------------------------------------------------------------
# Config
# ---------------------------------------------------------------------------

IDLE_SEC="${FCITX_IDLE_ENGLISH_SEC:-30}"
POLL_SEC="${FCITX_IDLE_ENGLISH_POLL:-1}"
NOTIFY="${FCITX_IDLE_ENGLISH_NOTIFY:-1}"
DEBUG="${FCITX_IDLE_ENGLISH_DEBUG:-1}"

case "${DEBUG,,}" in 1 | true | yes | on) DEBUG=1 ;; *) DEBUG=0 ;; esac
case "${NOTIFY,,}" in 1 | true | yes | on) NOTIFY=1 ;; *) NOTIFY=0 ;; esac
((IDLE_SEC < 3)) && IDLE_SEC=3

RUNTIME="${XDG_RUNTIME_DIR:-/tmp}"
LOCK_FILE="$RUNTIME/fcitx-idle-english.lock"
STAMP_FILE="$RUNTIME/fcitx-idle-english.stamp"
WATCH_DIR=""
MAIN_PID=$$
LOG_TAG="fcitx-idle-english"

EV_KEY=1
KEY_UNKNOWN=240

FCITX_DEST=org.fcitx.Fcitx5
FCITX_CTRL_PATH=/controller
FCITX_CTRL_IFACE=org.fcitx.Fcitx.Controller1
RIME_PATH=/rime
RIME_IFACE=org.fcitx.Fcitx.Rime1

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

log() {
  printf '[%s] %s\n' "$LOG_TAG" "$*" >&2
}

debug() {
  ((DEBUG)) || return 0
  printf '[%s][debug] %s %s\n' "$LOG_TAG" "$(date '+%H:%M:%S')" "$*" >&2
}

# Omarchy archives every on-screen toast into notification history.
# Drop our popup/history JSON so expire cannot move it there.
drop_ime_notification_history() {
  local base="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/notifications"
  local i f
  shopt -s nullglob
  for i in $(seq 1 40); do
    for f in "$base"/*.json "$base"/history/*.json; do
      [[ -f $f ]] || continue
      grep -q '"app":"Fcitx"' "$f" 2>/dev/null || continue
      grep -q '"summary":"输入法"' "$f" 2>/dev/null || continue
      rm -f "$f"
    done
    sleep 0.2
  done
}

notify_user() {
  ((NOTIFY)) || return 0
  # -e: freedesktop transient (popup only). Omarchy still files shown toasts
  # into history, so drop_ime_notification_history removes the matching files.
  notify-send -e -u low -a Fcitx "输入法" "$1" 2>/dev/null || true
  drop_ime_notification_history >/dev/null 2>&1 &
}

# ---------------------------------------------------------------------------
# Singleton + lifecycle
# ---------------------------------------------------------------------------

acquire_lock() {
  exec 9>"$LOCK_FILE"
  if ! flock -n 9; then
    log "another instance is already running; exiting"
    exit 0
  fi
  printf '%s\n' $$ >&9
}

kill_watchers() {
  local pidfile pid
  [[ -n $WATCH_DIR && -d $WATCH_DIR ]] || return 0
  for pidfile in "$WATCH_DIR"/*.pid; do
    [[ -f $pidfile ]] || continue
    pid=$(<"$pidfile")
    rm -f "$pidfile"
    [[ -n $pid ]] || continue
    # Watchers are started under `set -m`, so $pid is its own process-group
    # leader. Kill the group — never kill the leader first then pkill -P
    # (children get reparented and survive as orphans).
    if kill -0 -- "-$pid" 2>/dev/null; then
      kill -- "-$pid" 2>/dev/null || true
    elif kill -0 "$pid" 2>/dev/null; then
      pkill -P "$pid" 2>/dev/null || true
      kill "$pid" 2>/dev/null || true
    fi
  done
}

cleanup() {
  # Background watchers inherit traps. Only main may tear down WATCH_DIR.
  # Non-main must exit so SIGTERM from kill_watchers actually stops them.
  ((BASHPID == MAIN_PID)) || exit 0
  debug "shutdown"
  kill_watchers
  [[ -n $WATCH_DIR && -d $WATCH_DIR ]] && rm -rf "$WATCH_DIR"
  rm -f "$STAMP_FILE.tmp.$$"
}

shutdown() {
  cleanup
  exit 0
}

# ---------------------------------------------------------------------------
# Idle stamp
# ---------------------------------------------------------------------------

touch_stamp() {
  local now tmp
  now=$(date +%s)
  tmp=$(mktemp "$STAMP_FILE.tmp.XXXXXX") || return 1
  printf '%s\n' "$now" >"$tmp" || { rm -f "$tmp"; return 1; }
  mv -f "$tmp" "$STAMP_FILE" || { rm -f "$tmp"; return 1; }
  [[ -n ${1:-} ]] && debug "stamp ← $1"
}

idle_seconds() {
  local now last
  now=$(date +%s)
  last=$(cat "$STAMP_FILE" 2>/dev/null || true)
  [[ $last =~ ^[0-9]+$ ]] || last=$now
  echo $((now - last))
}

# ---------------------------------------------------------------------------
# Keyboard discovery
# ---------------------------------------------------------------------------

# Emit readable /dev/input/event* for real keyboards.
# Skips virtual devices and consumer-control interfaces (REL/ABS spam).
list_keyboards() {
  local name="" handlers="" rel="" abs="" event dev lowered

  flush() {
    [[ -n $handlers ]] || return 0

    event=""
    for event in $handlers; do
      [[ $event == event* ]] && break
      event=""
    done
    [[ -n $event ]] || return 0

    dev="/dev/input/$event"
    [[ -e $dev && -r $dev ]] || return 0

    lowered=$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]')

    case "$lowered" in
      *ydotool* | *virtual* | *speaker* | *"video bus"* | *"power button"* | \
      *"sleep button"* | *"lid switch"* | *hdmi* | *headphone* | *mic* | \
      *"line out"* | *"line in"* | *"pc speaker"* | *touchpad* | *trackpoint*)
        debug "skip $dev ($name) noise"
        return 0
        ;;
    esac

    if [[ $lowered == *mouse* && $lowered != *keyboard* ]]; then
      debug "skip $dev ($name) mouse"
      return 0
    fi

    if [[ " $handlers " != *" kbd "* && $lowered != *keyboard* ]]; then
      debug "skip $dev ($name) not-kbd"
      return 0
    fi

    if [[ -n $rel && $rel != 0 ]] || [[ -n $abs && $abs != 0 ]]; then
      debug "skip $dev ($name) has REL/ABS (consumer iface)"
      return 0
    fi

    debug "accept $dev ($name)"
    printf '%s\n' "$dev"
  }

  while IFS= read -r line || [[ -n $line ]]; do
    if [[ -z $line ]]; then
      flush
      name="" handlers="" rel="" abs=""
      continue
    fi
    case "$line" in
      "N: Name="*) name="${line#N: Name=}" ;;
      "H: Handlers="*) handlers="${line#H: Handlers=}" ;;
      "B: REL="*) rel="${line#B: REL=}" ;;
      "B: ABS="*) abs="${line#B: ABS=}" ;;
    esac
  done < /proc/bus/input/devices
  flush
}

# ---------------------------------------------------------------------------
# Activity watcher (evdev)
# ---------------------------------------------------------------------------

# Keep the device fd open and read one input_event at a time.
# bash `read -N` → EINVAL on evdev; binary also cannot live in $(...).
watch_device() {
  local dev="$1"
  local evbin="$WATCH_DIR/ev.$(basename "$dev").bin"
  local -a bytes
  local typ code val

  exec 3<"$dev" || {
    debug "cannot open $dev"
    return 0
  }
  debug "evdev fd open: $dev"

  while true; do
    if ! dd bs=24 count=1 iflag=fullblock status=none <&3 of="$evbin" 2>/dev/null; then
      debug "evdev dd failed on $dev; reopen in 1s"
      sleep 1
      exec 3<&-
      exec 3<"$dev" || break
      continue
    fi
    if [[ ! -s $evbin ]] || (($(wc -c <"$evbin") != 24)); then
      debug "evdev short read on $dev; reopen in 1s"
      sleep 1
      exec 3<&-
      exec 3<"$dev" || break
      continue
    fi

    mapfile -t bytes < <(od -An -v -t u1 "$evbin" | tr -s '[:space:]' '\n' | grep -E '^[0-9]+$' || true)
    ((${#bytes[@]} == 24)) || continue

    typ=$((bytes[16] | (bytes[17] << 8)))
    code=$((bytes[18] | (bytes[19] << 8)))
    val=$((bytes[20] | (bytes[21] << 8) | (bytes[22] << 16) | (bytes[23] << 24)))

    # Press / release / autorepeat. Ignore KEY_UNKNOWN spam.
    ((typ == EV_KEY)) || continue
    ((code != KEY_UNKNOWN)) || continue
    ((val == 0 || val == 1 || val == 2)) || continue

    touch_stamp "key $dev code=$code val=$val"
  done

  exec 3<&-
  rm -f "$evbin"
  debug "watcher stopped: $dev"
}

start_watchers() {
  local dev i=0 pid

  kill_watchers
  debug "scan keyboards watch_dir=$WATCH_DIR"

  # Own process group per watcher so kill_watchers can reap dd children via
  # `kill -- -$pid`. Without monitor mode, rescans leak orphans.
  set -m

  while IFS= read -r dev; do
    [[ -n $dev ]] || continue
    watch_device "$dev" &
    pid=$!
    echo "$pid" >"$WATCH_DIR/$i.pid"
    log "watching $dev (pid $pid)"
    i=$((i + 1))
  done < <(list_keyboards)

  set +m

  if ((i == 0)); then
    log "no readable keyboards (need group 'input'?)"
  else
    debug "watching $i keyboard device(s)"
  fi
}

# ---------------------------------------------------------------------------
# Rime / fcitx status
# ---------------------------------------------------------------------------

rime_dbus() {
  local method="$1"
  shift
  gdbus call --session \
    --dest "$FCITX_DEST" \
    --object-path "$RIME_PATH" \
    --method "$RIME_IFACE.$method" "$@" 2>/dev/null
}

fcitx_dbus() {
  local method="$1"
  shift
  gdbus call --session \
    --dest "$FCITX_DEST" \
    --object-path "$FCITX_CTRL_PATH" \
    --method "$FCITX_CTRL_IFACE.$method" "$@" 2>/dev/null
}

# Current fcitx IM unique name, e.g. rime / keyboard-us.
fcitx_current_im() {
  local out
  out=$(fcitx_dbus CurrentInputMethod) || return 1
  [[ $out =~ \'([^\']+)\' ]] || return 1
  printf '%s\n' "${BASH_REMATCH[1]}"
}

# Returns 0 if Rime is the active IM and in Chinese (ascii_mode=false).
# keyboard-us (or any non-Rime IM) and Rime English are already English — skip.
rime_is_chinese() {
  local im out
  im=$(fcitx_current_im) || return 1
  [[ $im == rime ]] || return 1
  out=$(rime_dbus IsAsciiMode) || return 1
  # gdbus prints "(false,)" or "(true,)"
  [[ $out == *false* ]]
}

rime_switch_english() {
  rime_dbus SetAsciiMode true >/dev/null
}

rime_schema() {
  rime_dbus GetCurrentSchema | tr -d "()', " || true
}

wait_for_rime() {
  local i
  for i in $(seq 1 60); do
    if rime_dbus IsAsciiMode >/dev/null; then
      debug "rime ready schema=$(rime_schema) chinese=$(rime_is_chinese && echo yes || echo no)"
      return 0
    fi
    debug "waiting for rime dbus..."
    sleep 1
  done
  log "rime dbus not available; will keep retrying"
}

# ---------------------------------------------------------------------------
# Main loop
# ---------------------------------------------------------------------------

main_loop() {
  local was_chinese=0 idle_for remain
  local rescan_every=120 loops=0

  while true; do
    loops=$((loops + 1))
    if ((loops >= rescan_every)); then
      start_watchers
      loops=0
    fi

    if rime_is_chinese; then
      if ((was_chinese == 0)); then
        touch_stamp "entered Chinese" || debug "stamp write failed (entered Chinese)"
        log "Chinese (Rime ascii=false); idle timer armed"
        was_chinese=1
      fi

      idle_for=$(idle_seconds)
      if ((DEBUG)); then
        remain=$((IDLE_SEC - idle_for))
        ((remain < 0)) && remain=0
        debug "zh idle=${idle_for}s remain=${remain}s"
      fi

      if ((idle_for >= IDLE_SEC)); then
        # Re-read immediately before switching: debug/gdbus or a just-arrived
        # key may have refreshed the stamp after idle_for was snapshotted.
        idle_for=$(idle_seconds)
        if ((idle_for < IDLE_SEC)); then
          debug "switch skipped; stamp refreshed idle=${idle_for}s"
        elif ((idle_for > IDLE_SEC * 5)); then
          debug "switch skipped; implausible idle=${idle_for}s (bad stamp?)"
          touch_stamp "implausible idle ignored"
        elif ! rime_is_chinese; then
          debug "switch skipped; already English im=$(fcitx_current_im || echo '?')"
          was_chinese=0
        else
          debug "threshold hit idle=${idle_for}s schema=$(rime_schema) → SetAsciiMode(true)"
          if rime_switch_english; then
            log "auto-switched to English after ${idle_for}s idle"
            notify_user "已自动切换到英文输入"
            was_chinese=0
            touch_stamp "after switch" || debug "stamp write failed (after switch)"
          else
            log "SetAsciiMode failed; will retry"
          fi
        fi
      fi
    else
      if ((was_chinese == 1)); then
        debug "left Chinese (manual Shift or external)"
      fi
      was_chinese=0
    fi

    sleep "$POLL_SEC"
  done
}

# ---------------------------------------------------------------------------
# Entry
# ---------------------------------------------------------------------------

acquire_lock
WATCH_DIR="$(mktemp -d "$RUNTIME/fcitx-idle-english.XXXXXX")"
trap cleanup EXIT
trap shutdown INT TERM

log "started (idle=${IDLE_SEC}s poll=${POLL_SEC}s notify=${NOTIFY} debug=${DEBUG})"
debug "pid=$$ stamp=$STAMP_FILE watch_dir=$WATCH_DIR"

wait_for_rime
touch_stamp "startup" || debug "stamp write failed (startup)"
start_watchers
main_loop
