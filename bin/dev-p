#!/usr/bin/env bash

session_name="dev-p"
projects_dir="$HOME/Projects"
folders=(yuler.dev airvoice typo)

if ! tmux has-session -t "=$session_name" 2>/dev/null; then
  # Window 1: ~/Projects with split panes
  tmux new-session -d -s "$session_name" -n 'projects' -c "$projects_dir"
  tmux split-window -h -t "$session_name:projects" -c "$projects_dir"
  tmux split-window -v -t "$session_name:projects" -c "$projects_dir"
  tmux select-pane -t "$session_name:projects.1"

  # Remaining windows: one tab per folder, tdl with mimo + agent
  for folder in "${folders[@]}"; do
    win_id=$(tmux new-window -t "$session_name:" -n "$folder" -c "$projects_dir/$folder" -P -F '#{window_id}')
    tmux send-keys -t "$win_id" 'tdl opencode cursor-agent' C-m
  done

  tmux select-window -t "$session_name:projects"
fi

tmux attach-session -t "=$session_name"
