{
  // Extend the Quickshell Omarchy menu with JSONC.
  //
  // IDs are object keys. The parent is inferred from the dotted id, so
  // "personal.notes" appears under "personal", and "personal" appears on the
  // root menu. Reuse an existing id to override/extend it.
  //
  // Fields:
  //   icon        Nerd Font glyph shown in the icon column.
  //   label       Visible row title.
  //   action      Shell command to run. If omitted, the row is a submenu.
  //   target      Existing submenu id to open. Use for links/aliases.
  //   provider    Runtime provider function/command returning JSON rows.
  //   aliases     alternate `omarchy menu summon <name>` routes; also searchable.
  //   keywords    Extra search terms beyond id/label/aliases.
  //   description Optional subtitle and extra search text.
  //   when        Shell condition; hide row when it fails.
  //   checked     Shell condition; append ✓ when it succeeds.

  "display.fixcolors": {
    "icon": "󰨰",
    "label": "Fix Monitor Colors",
    "description": "Toggle resolution to refresh display connection",
    "action": "fix-monitor-colors.sh && notify-send 'Monitor' 'Color fix applied'",
    "keywords": "monitor color display fix hdmi",
  },

  "chat.wechat-focus": {
    "icon": "󰘎",
    "label": "WeChat",
    "description": "Focus WeChat window if running, otherwise launch",
    "action": "~/.config/omarchy/bin/wechat-focus-or-launch",
    "keywords": "wechat weixin chat message",
  },

  "chat.fix-wechat-width": {
    "icon": "󱂬",
    "label": "Fix WeChat Width",
    "description": "Reset WeChat window to ~700px wide",
    "action": "omarchy-fix-wechat-width",
    "keywords": "wechat weixin chat width column resize",
  },

  "trigger.kill-tabs": {
    "icon": "󰖟",
    "label": "Kill Tabs",
    "description": "Free browser tab memory without closing windows",
    "action": "notify-send 'Kill Tabs' \"$(kill-tabs)\"",
    "keywords": "browser chrome memory tabs kill renderer",
  },

  "trigger.workplace-setup": {
    "icon": "󰍹",
    "label": "Workplace Setup",
    "description": "Lay out workplaces after login (manual; not on boot)",
    "action": "notify-send 'Workplace Setup' 'Starting…' && \"$HOME/Projects/dotfiles/bin/omarchy-workplace-setup\" && notify-send 'Workplace Setup' 'Done'",
    "keywords": "workplace setup workspace herdr layout boot login",
  },

  "trigger.workplace-split-wide-left": {
    "icon": "󰕰",
    "label": "Split 2/3 | 1/3",
    "description": "Left column 2/3, right 1/3 (WS1 AI GUI style)",
    "action": "omarchy-workplace-split 2/3 && notify-send 'Workplace Split' 'Left 2/3 · Right 1/3'",
    "keywords": "split width two thirds workplace layout",
  },

  "trigger.workplace-split-narrow-left": {
    "icon": "󰕰",
    "label": "Split 1/3 | 2/3",
    "description": "Left column 1/3, right 2/3 (WS3 chat style)",
    "action": "omarchy-workplace-split 1/3 && notify-send 'Workplace Split' 'Left 1/3 · Right 2/3'",
    "keywords": "split width one third workplace layout wechat",
  },
}
